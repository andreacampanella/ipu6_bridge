#!/bin/bash
# Intel IPU6 Camera Manager for Ubuntu 25.04
# Manages the camera streaming to virtual device

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
VIRTUAL_DEVICE="/dev/video50"
VIDEO_NR=50
SYSTEMD_SERVICE="ipu6-camera.service"

# Print colored message
print_msg() {
    local color=$1
    shift
    echo -e "${color}$@${NC}"
}

print_success() { print_msg "$GREEN" "✓ $@"; }
print_error() { print_msg "$RED" "✗ $@"; }
print_warning() { print_msg "$YELLOW" "⚠ $@"; }
print_info() { print_msg "$BLUE" "ℹ $@"; }

# Check if running as root
check_root() {
    if [ "$EUID" -eq 0 ]; then 
        print_error "Please do not run this script as root or with sudo"
        exit 1
    fi
}

# Check camera status
check_status() {
    print_info "Checking IPU6 Camera Status..."
    echo ""
    
    # Check if v4l2loopback is loaded
    if lsmod | grep -q v4l2loopback; then
        print_success "v4l2loopback module is loaded"
    else
        print_warning "v4l2loopback module is NOT loaded"
    fi
    
    # Check if virtual device exists
    if [ -e "$VIRTUAL_DEVICE" ]; then
        print_success "Virtual camera device exists: $VIRTUAL_DEVICE"
    else
        print_warning "Virtual camera device does NOT exist: $VIRTUAL_DEVICE"
    fi
    
    # Check systemd service
    if systemctl --user is-active --quiet "$SYSTEMD_SERVICE" 2>/dev/null; then
        print_success "Camera streaming service is RUNNING"
    else
        print_warning "Camera streaming service is NOT running"
    fi
    
    if systemctl --user is-enabled --quiet "$SYSTEMD_SERVICE" 2>/dev/null; then
        print_success "Camera service is ENABLED (auto-start on boot)"
    else
        print_warning "Camera service is NOT enabled (won't auto-start on boot)"
    fi
    
    # Check PSYS permissions
    if [ -e "/dev/ipu-psys0" ]; then
        PERMS=$(ls -l /dev/ipu-psys0 | awk '{print $1}')
        if [[ "$PERMS" == *"rw"*"rw"* ]]; then
            print_success "PSYS device has correct permissions: $PERMS"
        else
            print_warning "PSYS device may have incorrect permissions: $PERMS"
        fi
    else
        print_warning "PSYS device not found"
    fi
    
    # Check if gstreamer plugin exists
    if gst-inspect-1.0 icamerasrc &>/dev/null; then
        print_success "GStreamer icamerasrc plugin is installed"
    else
        print_error "GStreamer icamerasrc plugin is NOT installed"
    fi
    
    echo ""
}

# Start camera streaming
start_camera() {
    print_info "Starting IPU6 Camera..."
    
    # Check if v4l2loopback is loaded
    if ! lsmod | grep -q v4l2loopback; then
        print_info "Loading v4l2loopback module..."
        sudo modprobe v4l2loopback devices=1 video_nr=$VIDEO_NR card_label="Intel IPU6 Camera" exclusive_caps=1
        sleep 1
    fi
    
    # Check if virtual device exists
    if [ ! -e "$VIRTUAL_DEVICE" ]; then
        print_error "Virtual device $VIRTUAL_DEVICE was not created"
        print_info "Try reloading the module with: sudo modprobe -r v4l2loopback"
        exit 1
    fi
    
    # Start systemd service
    if systemctl --user is-active --quiet "$SYSTEMD_SERVICE" 2>/dev/null; then
        print_warning "Camera service is already running"
    else
        print_info "Starting camera streaming service..."
        systemctl --user start "$SYSTEMD_SERVICE"
        sleep 2
        
        if systemctl --user is-active --quiet "$SYSTEMD_SERVICE"; then
            print_success "Camera is now streaming to $VIRTUAL_DEVICE"
            print_info "You can now use the camera in Slack, Cheese, etc."
        else
            print_error "Failed to start camera service"
            print_info "Check logs with: journalctl --user -u $SYSTEMD_SERVICE -n 50"
            exit 1
        fi
    fi
}

# Stop camera streaming
stop_camera() {
    print_info "Stopping IPU6 Camera..."
    
    if systemctl --user is-active --quiet "$SYSTEMD_SERVICE" 2>/dev/null; then
        systemctl --user stop "$SYSTEMD_SERVICE"
        print_success "Camera streaming stopped"
    else
        print_warning "Camera service was not running"
    fi
}

# Restart camera streaming
restart_camera() {
    print_info "Restarting IPU6 Camera..."
    stop_camera
    sleep 1
    start_camera
}

# Enable auto-start on boot
enable_autostart() {
    print_info "Enabling camera auto-start on boot..."
    
    if systemctl --user is-enabled --quiet "$SYSTEMD_SERVICE" 2>/dev/null; then
        print_warning "Camera service is already enabled"
    else
        systemctl --user enable "$SYSTEMD_SERVICE"
        print_success "Camera will now start automatically on boot"
    fi
}

# Disable auto-start on boot
disable_autostart() {
    print_info "Disabling camera auto-start on boot..."
    
    if systemctl --user is-enabled --quiet "$SYSTEMD_SERVICE" 2>/dev/null; then
        systemctl --user disable "$SYSTEMD_SERVICE"
        print_success "Camera auto-start disabled"
    else
        print_warning "Camera service was not enabled"
    fi
}

# Show logs
show_logs() {
    print_info "Camera service logs (last 50 lines):"
    echo ""
    journalctl --user -u "$SYSTEMD_SERVICE" -n 50 --no-pager
}

# Test camera
test_camera() {
    print_info "Testing camera with GStreamer viewer..."
    print_info "Close the window to stop the test"
    echo ""
    
    gst-launch-1.0 icamerasrc ! videoconvert ! autovideosink
}

# Show usage
usage() {
    cat << EOF
Intel IPU6 Camera Manager

Usage: $(basename "$0") [COMMAND]

Commands:
    status          Show camera status and configuration
    start           Start camera streaming (loads modules if needed)
    stop            Stop camera streaming
    restart         Restart camera streaming
    enable          Enable camera auto-start on boot
    disable         Disable camera auto-start on boot
    logs            Show camera service logs
    test            Test camera with live viewer
    help            Show this help message

Examples:
    $(basename "$0") start          # Start the camera
    $(basename "$0") status         # Check if camera is working
    $(basename "$0") logs           # View error logs
    $(basename "$0") test           # Open camera viewer window

After starting, use $VIRTUAL_DEVICE in Slack, Cheese, etc.
EOF
}

# Main script logic
main() {
    check_root
    
    case "${1:-help}" in
        status)
            check_status
            ;;
        start)
            start_camera
            ;;
        stop)
            stop_camera
            ;;
        restart)
            restart_camera
            ;;
        enable)
            enable_autostart
            ;;
        disable)
            disable_autostart
            ;;
        logs)
            show_logs
            ;;
        test)
            test_camera
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            print_error "Unknown command: $1"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
